opam-version: "2.0"
synopsis: "Virtual opam dependency package for Spec2Code critics"
description: """
This virtual package pins the compatible opam toolchain used by the
Frama-C/WP and VerNFR critics. It has no build artifacts of its own.
"""
maintainer: ["Spec2Code maintainers"]
authors: ["Spec2Code maintainers"]
license: "MIT"
homepage: "https://github.com/rse-verification/Spec2Code"
bug-reports: "https://github.com/rse-verification/Spec2Code/issues"
pin-depends: [
  ["frama-c-vernfr.dev" "git+https://github.com/rse-verification/VerNFR.git#v1.1"]
]
depends: [
  "ocaml" {>= "5.4" & < "5.6"}
  "frama-c" {>= "33.0" & < "34.0"}
  "frama-c-vernfr"
]
